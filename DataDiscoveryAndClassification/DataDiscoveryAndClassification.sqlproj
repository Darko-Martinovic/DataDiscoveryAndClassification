<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <PropertyGroup>
    <Name>DataDiscoveryAndClassification</Name>
    <!-- SQL Server 2019 is the first version with ADD SENSITIVITY CLASSIFICATION. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql150DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultSchema>dbo</DefaultSchema>
    <TreatTSqlWarningsAsErrors>true</TreatTSqlWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" Version="150.1.2" DacpacName="master" />
  </ItemGroup>
  <ItemGroup>
    <Build Remove="PostDeploy\**" />
    <PostDeploy Include="PostDeploy\Seed.sql" />
  </ItemGroup>
</Project>
